# ============================================================
# x402 Hyperliquid Intelligence - Environment Variables
# ============================================================

# CDP API キー (production facilitator 用・必須)
# UUID 形式: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CDP_API_KEY_ID=

# base64 形式 (末尾 ==)
CDP_API_KEY_SECRET=

# Facilitator URL (v2)
FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# EVM 受領ウォレット (Base chain)
WALLET_ADDRESS=0xC67d94504696960bA0f2e7C3FeE703950734c00A

# Solana 受領ウォレット (base58)
SOLANA_WALLET_ADDRESS=4s8XQC2WzRfgH8Xiep7ybnCW11VKRCMwxQF6jknx3VPf

# Nansen API キー (Hyperliquid スマートマネーデータ)
NANSEN_API_KEY=

# Anthropic API キー (Claude 分析)
ANTHROPIC_API_KEY=

# Helius RPC URL (Solana・サーバーサイドのみ)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# アプリ公開 URL (Vercel デプロイ後に設定)
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# クライアントサイド Solana RPC (公開 RPC で OK)
NEXT_PUBLIC_HELIUS_RPC_URL=https://api.mainnet-beta.solana.com

# WalletConnect Project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=placeholder
